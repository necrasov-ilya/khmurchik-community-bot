BOT_TOKEN=
# Optional legacy fallback. Moderation works in the current chat.
BOT_TARGET_CHAT_ID=
BOT_POLL_TIMEOUT=30
BOT_ALLOWED_UPDATES=message,my_chat_member
BOT_LOG_LEVEL=info

BOT_DATABASE_HOST=postgres
BOT_DATABASE_PORT=5432
BOT_DATABASE_USER=postgres
BOT_DATABASE_PASSWORD=postgres
BOT_DATABASE_NAME=khmurchik_bot
BOT_DATABASE_SSL_MODE=disable
BOT_DATABASE_MAX_OPEN_CONNS=25
BOT_DATABASE_MAX_IDLE_CONNS=2
BOT_DATABASE_CONN_MAX_LIFETIME=5m

BOT_DEFAULT_TIMEZONE=Europe/Minsk
BOT_DEFAULT_GREETING_TIME=10:00
BOT_DEFAULT_GREETING_ENABLED=true
BOT_DEFAULT_GREETING_MESSAGE=Я робот, и Паша заставил меня каждое утро желать вам охуенного дня!
